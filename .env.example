# Copy this file to .env. Never commit the real .env.
GEMINI_API_KEY=your_personal_gemini_key
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
AURA_MOCK_AGENTS=true
API_HOST=0.0.0.0
API_PORT=8000
# FAL.ai key for Minimax Text-to-Video Max Turbo
FAL_KEY=your_fal_api_key_here
# Buffer → Settings → API → Create API Key.
# Connect Instagram, LinkedIn, and Facebook inside Buffer. Do not put social passwords here.
BUFFER_API_KEY=your_buffer_api_key
# TinyFish Search API. Used to discover lead companies and public posts. Not a company list.
TinyFish_API_KEY=your_tinyfish_api_key
# Lead emails are sent from this Gmail account to the address on the selected card.
# Gmail does not use an API key for sending. Turn on 2-Step Verification, then create
# an App Password at https://myaccount.google.com/apppasswords and paste it here.
LEAD_FROM_EMAIL=priyan123xyz@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Frontend-only; copy to web/.env.local as well.
NEXT_PUBLIC_API_URL=http://localhost:8000
