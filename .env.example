# Copy this file to .env. Never commit the real .env.
DEMO_MODE=true
AURA_ALLOW_RESET_DATA=false
AURA_COMPETITOR_INTELLIGENCE=true
AURA_COMPETITOR_REQUIRED=true
AURA_COMPETITOR_DISCOVERY=true
AURA_COMPETITOR_REFRESH=true
AURA_COMPETITOR_SCAN_INTERVAL=900
INTEL_WEBHOOK_TOKEN=
CHANGEDETECTION_API_KEY=
CHANGEDETECTION_PORT=5001
SEARXNG_PORT=8080
RSSHUB_PORT=1200
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
IMAGE_MODEL=fal-ai/flux/schnell
VIDEO_MODEL=minimax/h3-max-turbo
FAL_KEY=

# Database Configuration (MySQL aura or SQLite fallback)
DB_ENGINE=auto
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aura
MYSQL_USER=root
MYSQL_PASSWORD=

# Legacy / Platform settings
GEMINI_API_KEY=your_personal_gemini_key
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
AURA_MOCK_AGENTS=true
API_HOST=0.0.0.0
API_PORT=8000
# FAL.ai key for Minimax Text-to-Video Max Turbo
FAL_KEY=your_fal_api_key_here
# Buffer → Settings → API → Create API Key.
# Connect Instagram, LinkedIn, and Facebook inside Buffer. Do not put social passwords here.
BUFFER_API_KEY=your_buffer_api_key
BUFFER_ORGANIZATION_ID=
BUFFER_LINKEDIN_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_X_CHANNEL_ID=
BUFFER_PUBLISH_MODE=addToQueue

# Public HTTPS URL where AURA's /media static route is accessible (e.g. ngrok tunnel or production domain).
# Example: MEDIA_PUBLIC_BASE_URL=https://abc123.ngrok-free.app
MEDIA_PUBLIC_BASE_URL=

# TinyFish Search API. Used to discover lead companies and public posts. Not a company list.
TinyFish_API_KEY=your_tinyfish_api_key
# Lead emails are sent from this Gmail account to the address on the selected card.
# Gmail does not use an API key for sending. Turn on 2-Step Verification, then create
# an App Password at https://myaccount.google.com/apppasswords and paste it here.
LEAD_FROM_EMAIL=priyan123xyz@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
# Frontend-only; copy to web/.env.local as well.
NEXT_PUBLIC_API_URL=http://localhost:8000
